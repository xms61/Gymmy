{
  "name": "gymmy",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "verify": "npm run check:files && npm run check:docs && npm run check:skills && npm run test:scripts && npm run test:ci && npm run build",
    "check:docs": "node scripts/check-docs.mjs",
    "check:files": "node scripts/check-tracked-files.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "test:scripts": "node --test --test-reporter=dot \"scripts/**/*.test.mjs\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-functions=85 --test-coverage-branches=75 \"tests/**/*.test.ts\"",
    "test:ci": "npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
